# Copie para .env e preencha com os dados do app Web do seu projeto no Firebase
# (Configurações do projeto > Seus apps > SDK setup and configuration).
EXPO_PUBLIC_FIREBASE_API_KEY=
EXPO_PUBLIC_FIREBASE_AUTH_DOMAIN=
EXPO_PUBLIC_FIREBASE_PROJECT_ID=
EXPO_PUBLIC_FIREBASE_APP_ID=
EXPO_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
EXPO_PUBLIC_FIREBASE_STORAGE_BUCKET=

# Opcional: testar com os emuladores do Firebase (firebase emulators:start).
# No celular, use o IP do computador na rede, ex.: 192.168.0.10
# EXPO_PUBLIC_FIREBASE_EMULATOR_HOST=127.0.0.1
