rules_version = '2';

// Cada usuário só lê e grava as próprias viagens, em users/{uid}/trips/{tripId}.
// Exclusões são marcadas com deleted = true (para chegar aos outros aparelhos), nunca apagadas.
service cloud.firestore {
  match /databases/{database}/documents {
    match /users/{uid}/trips/{tripId} {
      function isOwner() {
        return request.auth != null && request.auth.uid == uid;
      }

      function validTrip() {
        let d = request.resource.data;
        return d.keys().hasOnly(['updatedAt', 'deleted', 'json', 'savedAt'])
          && d.updatedAt is number
          && d.deleted is bool
          && d.json is string
          && d.json.size() < 900000
          && d.savedAt == request.time;
      }

      allow read: if isOwner();
      allow create, update: if isOwner() && validTrip();
      allow delete: if false;
    }
  }
}
